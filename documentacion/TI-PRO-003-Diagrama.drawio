        <mxCell id="i1" value="1. Genera TICKET&#xa;de necesidad o falla" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#AED6F1;strokeColor=#1F4E79;fontColor=#1B4F72;fontSize=11;strokeWidth=2;arcSize=12;" vertex="1" parent="1">
