        <mxCell id="e1" value="1. Reporta con TICKET&#xa;Ej.: Tito — no le funciona el dispositivo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#A3E4D7;strokeColor=#0E6655;fontColor=#0E6655;fontSize=11;strokeWidth=2;arcSize=12;" vertex="1" parent="1">
