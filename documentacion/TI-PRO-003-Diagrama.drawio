        <mxCell id="enote" value="Si se daña un equipo de campo (guardia/supervisor), la compra va por este flujo. El usuario no espera a que TI haga el pedido." style="shape=note;whiteSpace=wrap;html=1;size=18;fillColor=#FCF3CF;strokeColor=#B7950B;fontSize=10;align=left;spacingLeft=8;fontColor=#7D6608;" vertex="1" parent="1">
