        <mxCell id="laneI" value="FLUJO A — CLIENTE INTERNO&#xa;Personal administrativo · Quito y Guayaquil" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#1F4E79;strokeWidth=2;fontStyle=1;fontSize=14;fontColor=#1F4E79;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
