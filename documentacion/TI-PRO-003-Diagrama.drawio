        <mxCell id="i6" value="Entrega al usuario y cierra ticket&#xa;(sin compra)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ABEBC6;strokeColor=#1D8348;fontColor=#145A32;fontSize=11;strokeWidth=2;arcSize=12;" vertex="1" parent="1">
