        <mxCell id="i5" value="3. TI elabora informe técnico&#xa;y SOLICITA la compra a Compras" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D7BDE2;strokeColor=#6C3483;fontColor=#4A235A;fontStyle=0;fontSize=11;strokeWidth=2;arcSize=12;" vertex="1" parent="1">
