        </mxCell>
        <mxCell id="inote" value="Siempre que el equipo tenga arreglo, no se compra. TI pide la compra solo si no hay solución técnica ni stock." style="shape=note;whiteSpace=wrap;html=1;size=18;fillColor=#FCF3CF;strokeColor=#B7950B;fontSize=10;align=left;spacingLeft=8;fontColor=#7D6608;" vertex="1" parent="1">
